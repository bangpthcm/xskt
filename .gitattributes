# Chuẩn hoá ký tự xuống dòng: lưu và checkout bằng LF cho mọi file văn bản
* text=auto eol=lf

# Script Windows cần CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# File nhị phân - không động vào
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.jar binary
*.apk binary
*.aab binary
*.jks binary
*.keystore binary
